# ==============================================================================
# Surakshit Basti — Environment Configuration Example (Names & Placeholders Only)
# ==============================================================================

# Database Configuration (PostgreSQL 17 + PostGIS 3.6.2)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=surakshit_basti
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# NASA Earthdata & PPS (Precipitation Processing System) Credentials
# Required for NASA GPM IMERG Early/Late Run NRT rainfall
EARTHDATA_TOKEN=your_earthdata_token_here
PPS_USERNAME=your_pps_registered_email_here
PPS_PASSWORD=your_pps_password_here
NASA_GPM_BASE_URL=https://jsimpsonhttps.pps.eosdis.nasa.gov/text/

# OpenStreetMap Overpass API Endpoint
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# AWS S3 Public Open Data Buckets (Unsigned / Public Read)
COPERNICUS_DEM_BUCKET=copernicus-dem-30m
ESA_WORLDCOVER_BUCKET=esa-worldcover

# Application Environment & Active District
APP_ENV=development
LOG_LEVEL=INFO
ACTIVE_DISTRICT=wayanad
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
